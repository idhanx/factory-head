# Copy to .env and adjust. Nothing secret belongs in the repository.

ENVIRONMENT=local            # local | staging | production
DEBUG=true

# The API and worker connect as a restricted role that row-level security
# applies to; the first migration creates it with APP_DB_PASSWORD. Migrations
# and seed scripts connect as the owning role instead.
DATABASE_URL=postgresql+psycopg://fm_app:change-me@localhost:5432/factorymanager
MIGRATION_DATABASE_URL=postgresql+psycopg://factorymanager:factorymanager@localhost:5432/factorymanager
APP_DB_PASSWORD=change-me
REDIS_URL=redis://localhost:6379/0

# Startup refuses the dev default outside `local`.
SECRET_KEY=change-me-to-something-at-least-32-bytes-long

CORS_ORIGINS=http://localhost:3000

# --- The sensor seam (§2, §9) ---------------------------------------------
# Leave false until a broker and devices actually exist: the ingest endpoint
# returns 503 while disabled, so a half-configured EMQX cannot inject data.
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
# Shared secret the EMQX rule sends as X-Ingest-Token. Ingest refuses every
# reading while this is empty, even with MQTT enabled.
INGEST_TOKEN=

# --- LLM serving (vLLM, OpenAI-compatible) --------------------------------
# Disabled by default. Every Coach briefing and Copilot answer falls back to
# deterministic text, which is never wrong — it just reads plainer.
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- WhatsApp (WATI) — §16.4 says apply on day one ------------------------
# 3-5 week approval in India. The escalation ladder runs without it and stays
# timestamped; it just reaches fewer phones.
WATI_ENABLED=false
WATI_BASE_URL=
WATI_API_TOKEN=
# Outside WhatsApp's 24-hour window only approved templates are delivered:
# templates named <prefix><kind> (fm_escalation, fm_shift_report, …) with a
# "message" parameter.
WATI_USE_TEMPLATES=false
WATI_TEMPLATE_PREFIX=fm_

# --- SMS fallback (MSG91, DLT-approved Flow template with ##message##) -----
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Browser push (the supervisor's 5-minute rung) --------------------------
# python scripts/generate_vapid_keys.py
WEBPUSH_ENABLED=false
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Links in messages point here; photos are stored under STORAGE_DIR.
APP_BASE_URL=http://localhost:3000
STORAGE_DIR=storage
